{
  "name": "jookoi-developer-stack",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "help": "node utility-scripts/npm-help.js",
    "gr": "graphify extract . --out _architecture/graphify --backend claude --token-budget 3000 --max-concurrency 1 --api-timeout 86400",
    "ollama": "ollama run deepseek-r1:8b-llama-distill-q4_K_M",
    "gr:ollama": "cross-env OLLAMA_BASE_URL=http://localhost:11434/v1 GRAPHIFY_OLLAMA_NUM_CTX=32768 GRAPHIFY_MAX_OUTPUT_TOKENS=16384 GRAPHIFY_API_TIMEOUT=86400 graphify extract . --out _architecture/graphify --backend ollama --model deepseek-r1:8b-llama-distill-q4_K_M --token-budget 3000 --max-concurrency 1",
    "gr:gemini": "graphify extract . --out _architecture/graphify --backend gemini --token-budget 3000 --max-concurrency 1",
    "gr:c": "graphify extract . --out _architecture/graphify --code-only",
    "gr:i": "graphify install && graphify hook install",
    "gr:query": "graphify query --graph _architecture/graphify/graphify-out/graph.json",
    "gr:tree": "graphify tree --graph _architecture/graphify/graphify-out/graph.json --output _architecture/graphify/graphify-out/GRAPH_TREE.html",
    "vault:push": "node utility-scripts/vault-sync.js push",
    "vault:pull": "node utility-scripts/vault-sync.js pull",
    "vault:push:dry": "node utility-scripts/vault-sync.js push --dry-run",
    "vault:pull:dry": "node utility-scripts/vault-sync.js pull --dry-run"
  },
  "devDependencies": {
    "cross-env": "^10.1.0"
  }
}
