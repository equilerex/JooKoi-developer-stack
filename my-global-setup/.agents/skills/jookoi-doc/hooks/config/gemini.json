{
  "//": "Merge into .gemini/hooks/hooks.json. Requires Gemini CLI v0.26.0+.",
  "//blocking": "Whether AfterAgent honours a blocking decision is unverified. doc-gate.sh degrades to a written reminder surfaced by the next SessionStart.",
  "hooks": {
    "AfterAgent": [
      {
        "hooks": [
          { "type": "command", "command": "sh .agents/skills/jookoi-doc/hooks/doc-gate.sh" }
        ]
      }
    ],
    "PreCompress": [
      {
        "hooks": [
          { "type": "command", "command": "sh .agents/skills/jookoi-doc/hooks/preserve.sh" }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compress|startup",
        "hooks": [
          { "type": "command", "command": "sh .agents/skills/jookoi-doc/hooks/rehydrate.sh" }
        ]
      }
    ]
  }
}
