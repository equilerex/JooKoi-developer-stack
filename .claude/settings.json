{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PROJECT_DIR}/my-global-setup/.agents/skills/jookoi-doc/hooks/doc-gate.sh\"" }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PROJECT_DIR}/my-global-setup/.agents/skills/jookoi-doc/hooks/doc-gate.sh\"" }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PROJECT_DIR}/utility-scripts/jookoi-hooks/session-log.sh\" session-end" }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PROJECT_DIR}/utility-scripts/jookoi-hooks/session-log.sh\" pre-compact" }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PROJECT_DIR}/utility-scripts/jookoi-hooks/session-start-reminder.sh\"" }
        ]
      }
    ]
  }
}
